<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#08090D"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="AKLAH AI"
            android:textColor="#F6F7FB"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/btnUndoTop"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↶"
            android:textSize="25sp"
            android:textColor="#DCE0E8"
            android:background="#181A21"/>
        <TextView
            android:id="@+id/btnRedoTop"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="↷"
            android:textSize="25sp"
            android:textColor="#DCE0E8"
            android:background="#181A21"/>
        <TextView
            android:id="@+id/btnExportTop"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Export"
            android:textColor="#111319"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_button_gold"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="#050608">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#050608"
            app:resize_mode="fit"
            app:use_controller="false"
            app:show_buffering="when_playing"/>

        <FrameLayout
            android:id="@+id/textOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/btnPlayPause"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="▶"
            android:textSize="23sp"
            android:textColor="#FFFFFF"
            android:background="#66000000"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvPlayheadTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        <SeekBar
            android:id="@+id/timelineSeek"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FFD66B"
            android:thumbTint="#FFD66B"/>
        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#9DA3B2"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="TIMELINE  •  Tap a clip to select"
        android:textColor="#AEB4C1"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <HorizontalScrollView
        android:id="@+id/timelineRulerScroll"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:paddingHorizontal="8dp">
        <LinearLayout
            android:id="@+id/timelineRuler"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/timelineClipScroll"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fillViewport="false"
        android:scrollbars="horizontal"
        android:paddingHorizontal="8dp">
        <LinearLayout
            android:id="@+id/clipStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/timelineLayerStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0F14"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#9EA4B1"
            android:textSize="10sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvClipInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Select clip"
            android:textColor="#858C9A"
            android:textSize="10sp"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scrollbars="none"
        android:paddingHorizontal="6dp">
        <LinearLayout
            android:id="@+id/toolCategories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row1Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row2Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row4Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row5Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row7Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row7"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/row6Scroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:id="@+id/row6"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>
    </LinearLayout>
</LinearLayout>
