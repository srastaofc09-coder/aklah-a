<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Project"
        android:textColor="@color/gold"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProjectName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card"
        android:hint="Project ka naam"
        android:inputType="text"
        android:paddingStart="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/grey_text" />

    <TextView
        android:id="@+id/btnPickMedia"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:text="+ Video / Image / Audio chunein"
        android:textColor="@color/gold"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMediaList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:minHeight="100dp"
        android:padding="16dp"
        android:text="Abhi koi media nahi chuni"
        android:textColor="@color/grey_text" />

    <TextView
        android:id="@+id/btnSaveProject"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_gold"
        android:gravity="center"
        android:text="Project Save Karein"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
